rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Invitation-only content (e.g. the Friday-night programme).
    // access/{audience} = { householdIds: [...], phones: [...] } where phones is
    // DERIVED from those households' managerPhones (see scripts/firestore.js
    // `friday sync`). Guests can never read this doc, so the guest list of an
    // audience stays private.
    function isInAudience(audience) {
      return isSignedIn()
        && request.auth.token.phone_number in
           get(/databases/$(database)/documents/access/$(audience)).data.phones;
    }

    function isFridayGuest() {
      return isInAudience('friday');
    }

    // Households staying on the Domaine ("Logé au Domaine" = Oui in the guest list).
    function isLodgingGuest() {
      return isInAudience('lodging');
    }

    // Friday invitees who also stay on the Domaine (DERIVED: friday ∩ lodging).
    function isFridayLodgingGuest() {
      return isInAudience('fridayLodging');
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // manage via Firebase console only
    }

    match /access/{audience} {
      allow read, write: if isAdmin();
    }

    match /info/{sectionId} {
      // public — except the Friday programme, invited households only
      allow read: if sectionId != 'schedule-friday' || isFridayGuest() || isAdmin();
      allow write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /households/{householdId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /persons/{personId} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        || (isSignedIn() && request.auth.token.phone_number in
            get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.managerPhones);
    }

    match /guests/{guestId} {
      allow create: if isSignedIn()
        && request.auth.uid == guestId
        && request.resource.data.phoneNumber == request.auth.token.phone_number;
      allow get, list: if isAdmin() || (isSignedIn() && request.auth.uid == guestId);
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == guestId);
    }

    // Every event has audience "all", "friday", "lodging" or "fridayLodging".
    // Clients must query with where('audience', '==', ...) — an unfiltered
    // query is rejected.
    match /events/{eventId} {
      allow read: if resource.data.audience == 'all'
        || (resource.data.audience == 'friday' && isFridayGuest())
        || (resource.data.audience == 'lodging' && isLodgingGuest())
        || (resource.data.audience == 'fridayLodging' && isFridayLodgingGuest())
        || isAdmin();
      allow write: if isAdmin();
    }

    // Answers to "fridayLodging" events (Vendredi soir - Dodo).
    match /fridayLodgingRsvps/{personId} {
      allow read: if isFridayLodgingGuest() || isAdmin();
      allow write: if isAdmin() || (isFridayLodgingGuest()
        && request.resource.data.householdId ==
           get(/databases/$(database)/documents/persons/$(personId)).data.householdId
        && request.auth.token.phone_number in
           get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.managerPhones);
    }

    // Answers to "lodging" events (Samedi - Dodo), same model as fridayRsvps.
    match /lodgingRsvps/{personId} {
      allow read: if isLodgingGuest() || isAdmin();
      allow write: if isAdmin() || (isLodgingGuest()
        && request.resource.data.householdId ==
           get(/databases/$(database)/documents/persons/$(personId)).data.householdId
        && request.auth.token.phone_number in
           get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.managerPhones);
    }

    // Answers to invitation-only events live here rather than in
    // persons.attendance, because persons are readable by every guest.
    // fridayRsvps/{personId} = { householdId, attendance: { [eventId]: bool|null } }
    match /fridayRsvps/{personId} {
      allow read: if isFridayGuest() || isAdmin();
      allow write: if isAdmin() || (isFridayGuest()
        && request.resource.data.householdId ==
           get(/databases/$(database)/documents/persons/$(personId)).data.householdId
        && request.auth.token.phone_number in
           get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.managerPhones);
    }

    match /photos/{photoId} {
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.guestId == request.auth.uid)
        || (isSignedIn() && resource.data.status == 'approved');
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.guestId == request.auth.uid
        && request.resource.data.status == 'approved';
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.guestId == request.auth.uid
            && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.guestId == request.auth.uid);
    }

    // settings/sections = admin on/off switches (menu + info pages); public
    // because the info pages are readable without signing in.
    match /settings/{settingId} {
      allow read: if settingId == 'sections' || isSignedIn();
      allow write: if isAdmin();
    }

    match /notes/{noteId} {
      // Guestbook-style notes visible to all signed-in guests
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.guestId == request.auth.uid
        && request.resource.data.keys().hasAll(["guestId", "content", "createdAt"]);
      allow update: if isSignedIn()
        && resource.data.guestId == request.auth.uid
        && request.resource.data.keys().hasOnly(["guestId", "content", "updatedAt"]);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.guestId == request.auth.uid);
    }
  }
}
